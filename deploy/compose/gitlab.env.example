# Copy this file to deploy/compose/gitlab.env and fill the token locally.
# Never commit a real token. The token needs GitLab `api` scope so the
# control plane can list and create pipelines.
CI_PROVIDER=gitlab
GITLAB_BASE_URL=https://gitlab.com
GITLAB_PROJECT_ID=stu-group5083235/stu-project
GITLAB_TOKEN=
GITLAB_REF=main
