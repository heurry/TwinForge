+
+def _get_dense_tp_overlap_state(
+    device: torch.device,
+) -> tuple[torch.cuda.Stream, torch.cuda.Event, torch.cuda.Event, torch.cuda.Event]:
+    device_index = device.index
+    assert device_index is not None
+    state = _DENSE_TP_OVERLAP_STATES.get(device_index)
+    if state is None:
+        with torch.cuda.device(device_index):
+            state = (
+                torch.cuda.Stream(device=device),
+                torch.cuda.Event(),
+                torch.cuda.Event(),
+                torch.cuda.Event(),
+            )
+        _DENSE_TP_OVERLAP_STATES[device_index] = state
+    return state
